# Akshaya Caterers — Environment Variables Configuration

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Optional for local dev, Required for Supabase Cloud)
# When left empty, the application automatically persists to .data/db.json
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
ADMIN_SESSION_SECRET=akshaya_secret_session_token_replace_in_production_987654321
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=akshaya2026!

# ------------------------------------------------------------------------------
# SITE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
